{
	"name": "astro-workers-template",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
