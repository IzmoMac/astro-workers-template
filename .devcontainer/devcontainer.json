{
  "name": "astro-workers",

  // TypeScript/Node base — pnpm is enabled via corepack in postCreateCommand
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},

    // Claude Code CLI, auto-updating. Pin a version instead if you want
    // reproducible builds (see comment in postCreateCommand).
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},

    // gh CLI — handy for PRs / repo setup from inside the container
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {},

    // For the Cloudflare Access / Terraform pieces
    "ghcr.io/devcontainers/features/terraform:1.4.4": {},

    // ripgrep, fzf, zsh niceties etc.
    "ghcr.io/devcontainers/features/common-utils:2.5.9": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },

  // Astro dev server (4321) + wrangler dev (8787, and 8788 for a second worker if needed)
  "forwardPorts": [4321, 8787, 8788],
  "portsAttributes": {
    "4321": { "label": "Astro dev", "onAutoForward": "notify" },
    "8787": { "label": "Wrangler dev (Worker)", "onAutoForward": "notify" }
  },

  "containerEnv": {
    // Stops Claude Code auto-update inside the container if you want pinned versions;
    // remove this line if you're fine with auto-update.
    "DISABLE_AUTOUPDATER": "0",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },

  // Pass host-side secrets through rather than baking them into the image.
  "remoteEnv": {
    "CLOUDFLARE_API_TOKEN": "${localEnv:CLOUDFLARE_API_TOKEN}",
    "CLOUDFLARE_ACCOUNT_ID": "${localEnv:CLOUDFLARE_ACCOUNT_ID}",

    // For infra/init.sh (Terraform state lives in an R2 bucket).
    "TF_STATE_BUCKET": "${localEnv:TF_STATE_BUCKET}",

    // Terraform's "s3" backend is a generic S3-protocol client (R2 is
    // S3-compatible) but it's built on the AWS SDK, so it only looks for
    // credentials in AWS_-named env vars — no AWS account involved, this is
    // your R2 API token's key pair renamed for that reason.
    "AWS_ACCESS_KEY_ID": "${localEnv:R2_ACCESS_KEY_ID}",
    "AWS_SECRET_ACCESS_KEY": "${localEnv:R2_SECRET_ACCESS_KEY}"
  },

  // Persist Claude Code auth/memory, gh CLI auth, and Wrangler login across rebuilds.
  "mounts": [
    "source=claude-code-config,target=/home/node/.claude,type=volume",
    "source=gh-cli-config,target=/home/node/.config/gh,type=volume"
    // "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached",
    // "source=fincapanel-wrangler-config,target=/home/node/.config/.wrangler,type=volume",
    // "source=fincapanel-pnpm-store,target=/home/node/.local/share/pnpm/store,type=volume"
  ],

  // corepack gives you the exact pnpm version pinned in package.json (packageManager field).
  // wrangler + skills CLI are left as npx/pnpm-dlx tools rather than global installs,
  // so version drift is controlled by your lockfile / CI instead of the container image.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code",
        "github.vscode-github-actions",
        "astro-build.astro-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "hashicorp.terraform",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "usernamehw.errorlens",
        "christian-kohler.path-intellisense"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  "remoteUser": "node"
}
